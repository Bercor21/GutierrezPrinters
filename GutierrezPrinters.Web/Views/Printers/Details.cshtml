@model Printer
@{
    ViewData["Title"] = Model.DisplayName;
    var orders = Model.Orders.OrderByDescending(o => o.Id).ToList();
    foreach (var o in orders)
    {
        o.Printer = Model;
    }

    var whatGoes = orders.Count == 0 ? "" : $" con {orders.Count} {(orders.Count == 1 ? "orden" : "órdenes")}";
    var deleteNote = $"Se borra esta impresora{whatGoes}. El cliente se queda. No se puede deshacer.";
    var deleteQuestion = $"¿Eliminar la impresora {Model.DisplayName}{whatGoes}? Esto no se puede deshacer.";
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
    <div>
        <h1 class="page-title">@Model.DisplayName</h1>
        <div class="text-body-secondary">
            De <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId">@Model.Customer?.Name</a>
            · @(string.IsNullOrEmpty(Model.SerialNumber) ? "sin número de serie" : "S/N " + Model.SerialNumber)
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-primary" asp-controller="Orders" asp-action="Create" asp-route-printerId="@Model.Id">+ Ingresar de nuevo</a>
        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header">Datos del equipo</div>
            <div class="card-body">
                <dl class="data-list">
                    <dt>Marca</dt><dd>@Model.Brand</dd>
                    <dt>Modelo</dt><dd>@Model.Model</dd>
                    <dt>Serie</dt><dd>@Display.OrEmpty(Model.SerialNumber)</dd>
                    <dt>Tecnología</dt><dd>@Model.Technology.Name()</dd>
                    <dt>Tipo</dt><dd>@Model.Category.Name()</dd>
                    <dt>Multifuncional</dt><dd>@(Model.IsMultifunction ? "Sí" : "No")</dd>
                    <dt>Color</dt><dd>@(Model.IsColor ? "Sí" : "No")</dd>
                    <dt>Detalles</dt><dd>@Display.OrEmpty(Model.Description)</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header">Historial: veces que ha entrado al taller (@orders.Count)</div>
            @if (orders.Any())
            {
                <div class="list-group list-group-flush">
                    @foreach (var order in orders)
                    {
                        <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" class="list-group-item list-group-item-action order-item">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div class="min-w-0">
                                    <div><span class="order-number">@order.Number</span> <span class="order-meta">· @Display.Date(order.ReceivedAt)</span></div>
                                    <div class="order-meta text-truncate">Falla: @order.ReportedIssue</div>
                                    @if (!string.IsNullOrWhiteSpace(order.Diagnosis))
                                    {
                                        <div class="order-meta text-truncate">Diagnóstico: @order.Diagnosis</div>
                                    }
                                </div>
                                <partial name="_StatusBadge" model="order.Status" />
                            </div>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="card-body text-body-secondary">Sin órdenes.</div>
            }
        </div>
    </div>
</div>

@if (User.IsInRole(SeedData.AdminRole))
{
    <div class="danger-zone">
        <div>
            <div class="danger-zone-title">Eliminar impresora</div>
            <div class="text-body-secondary small">@deleteNote</div>
        </div>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
              data-confirm="@deleteQuestion">
            <button type="submit" class="btn btn-outline-magenta">Eliminar impresora</button>
        </form>
    </div>
}
