@model RepairOrder
@{
    var customer = Model.Printer?.Customer;
    var serial = Model.Printer?.SerialNumber;
}
<a asp-controller="Orders" asp-action="Details" asp-route-id="@Model.Id" class="order-row @Display.StatusTone(Model.Status)">
    <span class="order-number">@Model.Number</span>
    <span class="who">
        <span class="primary-text d-block">@customer?.Name</span>
        <span class="secondary-text d-block">@customer?.Phone</span>
    </span>
    <span class="what">
        <span class="primary-text d-none d-lg-block">@Model.Printer?.DisplayName</span>
        <span class="secondary-text d-block">
            <span class="d-lg-none">@Model.Printer?.DisplayName</span>
            @if (!string.IsNullOrEmpty(serial))
            {
                <span class="d-none d-lg-inline">Serie @serial</span>
            }
        </span>
    </span>
    <span class="state"><partial name="_StatusBadge" model="Model.Status" /></span>
    <span class="when">@Display.Date(Model.ReceivedAt)</span>
</a>
