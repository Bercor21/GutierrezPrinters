@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="card">
    <div class="card-body py-5 text-center">
        <h1 class="page-title text-danger mb-2">Algo salió mal</h1>
        <p class="text-body-secondary mb-4">Ocurrió un error al procesar la solicitud. Intentá de nuevo en un momento.</p>
        @if (Model.ShowRequestId)
        {
            <p class="small text-body-secondary">Código del error: <code>@Model.RequestId</code></p>
        }
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Volver al inicio</a>
    </div>
</div>
