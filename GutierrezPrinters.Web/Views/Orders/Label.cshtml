@model RepairOrder
@inject IOptions<ShopOptions> ShopSettings
@{
    Layout = null;
    var shop = ShopSettings.Value;
    var printer = Model.Printer!;
    var customer = printer.Customer!;
    // El QR lleva la dirección de esta orden: al escanearlo con el cel se abre la ficha completa.
    var orderUrl = Links.Order(Url, shop, Model.Id);
    var usesLocalAddress = string.IsNullOrWhiteSpace(shop.PublicUrl) &&
                           (Context.Request.Host.Host is "localhost" or "127.0.0.1");
    // Tamaño de la etiqueta (por defecto 4 × 6 pulgadas, vertical).
    var w = Display.Css(shop.LabelWidthMm);
    var h = Display.Css(shop.LabelHeightMm);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Etiqueta @Model.Number</title>
    <link rel="stylesheet" href="~/css/print.css" asp-append-version="true" />
    <style>
        @@page { size: @(w)mm @(h)mm; margin: 0; }
        .label { width: @(w)mm; height: @(h)mm; }
    </style>
</head>
<body class="print-preview">
    <div class="toolbar">
        <button type="button" onclick="window.print()">Imprimir etiqueta</button>
        <p>En la ventana de impresión: la impresora de etiquetas, papel <strong>4 × 6 pulg (10 × 15 cm)</strong>,
           márgenes <strong>Ninguno</strong> y escala <strong>100 %</strong>.</p>
        @if (usesLocalAddress)
        {
            <p class="warn">Este QR apunta a esta compu (@Context.Request.Host) y no abre desde el celular.
               Va a funcionar cuando el sistema esté publicado en internet.</p>
        }
    </div>

    <div class="label">
        <header class="label-shop">
            <img class="label-wordmark" src="~/img/wordmark-black.png" alt="@shop.Name" />
            @if (!string.IsNullOrWhiteSpace(shop.Phone))
            {
                <span class="label-shop-phone">Tel. @shop.Phone</span>
            }
        </header>

        <div class="label-top">
            <div>
                <div class="label-caption">Orden</div>
                <div class="label-number">@Model.Number</div>
                <div class="label-date">Ingresó @Display.Date(Model.ReceivedAt)</div>
            </div>
            <div class="label-qr" data-qr="@orderUrl"></div>
        </div>

        <dl class="label-data">
            <dt>Cliente</dt>
            <dd class="strong">@customer.Name</dd>
            <dt>Teléfono</dt>
            <dd class="strong">@customer.Phone</dd>
            <dt>Equipo</dt>
            <dd>@printer.DisplayName</dd>
            @if (!string.IsNullOrEmpty(printer.SerialNumber))
            {
                <dt>Serie</dt>
                <dd class="serial">@printer.SerialNumber</dd>
            }
            <dt>Falla</dt>
            <dd class="issue">@Model.ReportedIssue</dd>
            @if (!string.IsNullOrWhiteSpace(Model.Accessories))
            {
                <dt>Dejó</dt>
                <dd class="issue">@Model.Accessories</dd>
            }
        </dl>
    </div>

    <script src="~/lib/qrcode-generator/qrcode.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
