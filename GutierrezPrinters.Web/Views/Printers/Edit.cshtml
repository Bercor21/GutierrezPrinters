@model Printer
@{
    ViewData["Title"] = "Editar impresora";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <h1 class="page-title mb-1">Editar impresora</h1>
        <p class="text-body-secondary">De @Model.Customer?.Name</p>
        <div class="card">
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Brand" class="form-label"></label>
                            <input asp-for="Brand" class="form-control" />
                            <span asp-validation-for="Brand" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Model" class="form-label"></label>
                            <input asp-for="Model" class="form-control" />
                            <span asp-validation-for="Model" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="SerialNumber" class="form-label"></label>
                            <input asp-for="SerialNumber" class="form-control" />
                        </div>
                        <div class="col-6 col-md-4">
                            <label asp-for="Technology" class="form-label"></label>
                            <select asp-for="Technology" asp-items="Html.GetEnumSelectList<PrinterTechnology>()" class="form-select"></select>
                        </div>
                        <div class="col-6 col-md-4">
                            <label asp-for="Category" class="form-label"></label>
                            <select asp-for="Category" asp-items="Html.GetEnumSelectList<PrinterCategory>()" class="form-select"></select>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-check-inline">
                                <input asp-for="IsMultifunction" class="form-check-input" />
                                <label asp-for="IsMultifunction" class="form-check-label"></label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input asp-for="IsColor" class="form-check-input" />
                                <label asp-for="IsColor" class="form-check-label"></label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Guardar</button>
                        <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
