@model NewUserViewModel
@{
    ViewData["Title"] = "Nuevo usuario";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <h1 class="page-title mb-1">Nuevo usuario</h1>
        <p class="page-subtitle mb-3">Ponele una contraseña temporal y decile que la cambie apenas entre, en el menú de arriba a la derecha.</p>
        <div class="panel">
            <div class="panel-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="off" inputmode="email" />
                        <div class="form-text">Es con lo que va a entrar. Si no usa correo, inventale uno, por ejemplo diego@gutierrezprinters.com.</div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" type="text" class="form-control" autocomplete="off" />
                        <div class="form-text">Mínimo 8 caracteres, con al menos un número y una minúscula.</div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="form-check mb-4">
                        <input asp-for="IsAdmin" class="form-check-input" />
                        <label asp-for="IsAdmin" class="form-check-label"></label>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Crear usuario</button>
                        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
