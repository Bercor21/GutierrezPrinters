@model List<Customer>
@{
    ViewData["Title"] = "Clientes";
    var query = ViewData["Query"] as string;
}

<h1 class="page-title mb-3">Clientes</h1>

<form asp-action="Index" method="get" class="mb-3 search-box" role="search">
    <div class="input-group">
        <input type="search" name="q" value="@query" class="form-control" placeholder="Nombre, teléfono, correo o cédula" aria-label="Buscar cliente" autocomplete="off" />
        <button class="btn btn-primary" type="submit">Buscar</button>
    </div>
</form>

@if (Model.Any())
{
    <div class="card">
        <div class="list-group list-group-flush">
            @foreach (var c in Model)
            {
                <a asp-action="Details" asp-route-id="@c.Id" class="list-group-item list-group-item-action order-item">
                    <div class="d-flex justify-content-between align-items-center gap-2">
                        <div class="min-w-0">
                            <div class="fw-semibold text-truncate">@c.Name</div>
                            <div class="order-meta text-truncate">@c.Phone@(string.IsNullOrEmpty(c.Email) ? "" : " · " + c.Email)</div>
                        </div>
                        <span class="badge text-bg-light border flex-shrink-0">@c.Printers.Count @(c.Printers.Count == 1 ? "equipo" : "equipos")</span>
                    </div>
                </a>
            }
        </div>
    </div>
}
else
{
    <div class="card card-body text-center text-body-secondary py-5">
        @(string.IsNullOrWhiteSpace(query) ? "Todavía no hay clientes. Se crean solos al registrar un ingreso." : "No se encontraron clientes con esa búsqueda.")
    </div>
}
