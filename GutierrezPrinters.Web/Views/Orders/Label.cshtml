@model RepairOrder
@inject IOptions<ShopOptions> ShopSettings
@{
    Layout = null;
    var shop = ShopSettings.Value;
    var printer = Model.Printer!;
    var customer = printer.Customer!;
    // El QR lleva la dirección de esta orden: al escanearlo con el cel se abre la ficha completa.
    var orderUrl = Url.Action("Details", "Orders", new { id = Model.Id }, Context.Request.Scheme);
    var w = shop.LabelWidthMm;
    var h = shop.LabelHeightMm;
    var qrSize = Math.Min(h - 6, w / 2);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Etiqueta @Model.Number</title>
    <style>
        @@page { size: @(w)mm @(h)mm; margin: 0; }
        * { box-sizing: border-box; }
        html, body { margin: 0; padding: 0; font-family: Arial, Helvetica, sans-serif; color: #000; }
        body { background: #e9edf2; }
        .label {
            width: @(w)mm; height: @(h)mm; padding: 2.5mm;
            background: #fff; display: flex; gap: 2.5mm; align-items: center; overflow: hidden;
            margin: 16px auto; box-shadow: 0 2px 10px rgba(0,0,0,.15);
        }
        .qr { width: @(qrSize)mm; height: @(qrSize)mm; flex-shrink: 0; }
        .qr svg { width: 100%; height: 100%; display: block; }
        .info { min-width: 0; flex: 1; line-height: 1.15; }
        .num { font-size: 15pt; font-weight: 800; letter-spacing: .02em; }
        .line { font-size: 7.5pt; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .name { font-size: 8.5pt; font-weight: 700; }
        .shop { font-size: 6pt; color: #333; margin-top: .6mm; }
        .toolbar { text-align: center; font-family: system-ui, sans-serif; font-size: 14px; padding: 8px 12px 24px; color: #333; }
        .toolbar button { font-size: 16px; padding: 8px 22px; border-radius: 8px; border: 0; background: #1f4e8c; color: #fff; cursor: pointer; }
        .toolbar p { max-width: 460px; margin: 10px auto 0; }
        @@media print {
            body { background: #fff; }
            .label { margin: 0; box-shadow: none; }
            .toolbar { display: none; }
        }
    </style>
</head>
<body>
    <div class="label">
        <div class="qr" data-qr="@orderUrl"></div>
        <div class="info">
            <div class="num">@Model.Number</div>
            <div class="line name">@customer.Name</div>
            <div class="line">Tel. @customer.Phone</div>
            <div class="line">@printer.DisplayName</div>
            @if (!string.IsNullOrEmpty(printer.SerialNumber))
            {
                <div class="line">S/N @printer.SerialNumber</div>
            }
            <div class="line">Ingresó @Display.Date(Model.ReceivedAt)</div>
            <div class="line shop">@shop.Name</div>
        </div>
    </div>

    <div class="toolbar">
        <button type="button" onclick="window.print()">Imprimir etiqueta</button>
        <p>En la ventana de impresión escogé la impresora de etiquetas, tamaño de papel @(w) × @(h) mm,
           márgenes "Ninguno" y escala 100 %.</p>
    </div>

    <script src="~/lib/qrcode-generator/qrcode.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
